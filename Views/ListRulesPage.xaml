<?xml version='1.0' encoding='utf-8'?>
<Page xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:models="using:PortManager.Models" xmlns:controls="using:PortManager.Controls" x:Class="PortManager.Views.ListRulesPage" Loaded="Page_Loaded">
    <Grid Padding="32,28" RowSpacing="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="{StaticResource Rules_Title}" Style="{StaticResource PageTitle}" TextWrapping="Wrap"/>
            <TextBlock Text="{StaticResource Rules_Subtitle}" Style="{StaticResource PageSubtitle}" TextWrapping="Wrap"/>
        </StackPanel>
        <InfoBar x:Name="ErrorBar" Grid.Row="1" IsOpen="False" Severity="Error" Title="{StaticResource Common_FirewallError}" Message="{StaticResource Common_FirewallErrorDetail}"/>
        <Grid Grid.Row="2" ColumnSpacing="10" controls:AdaptiveLayout.CompactBelow="560" RowSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MaxWidth="420"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="SearchBox" PlaceholderText="{StaticResource Rules_SearchPlaceholder}" TextChanged="SearchBox_TextChanged"/>
            <Button Grid.Column="1" Width="40" Height="36" Click="RefreshButton_Click" ToolTipService.ToolTip="{StaticResource Common_Refresh}" AutomationProperties.Name="{StaticResource Common_Refresh}">
                <FontIcon Glyph=""/>
            </Button>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <ProgressRing x:Name="LoadingRing" Width="20" Height="20" IsActive="False"/>
                <TextBlock x:Name="RuleCountText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
            </StackPanel>
        </Grid>
        <ListView Grid.Row="3" x:Name="RulesList" SelectionMode="None">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="Margin" Value="0,0,0,8"/>
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:FirewallRule">
                    <Border Style="{StaticResource CardPanel}" Padding="16,12">
                        <Grid ColumnSpacing="16" controls:AdaptiveLayout.CompactBelow="680" RowSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="80"/>
                            </Grid.ColumnDefinitions>
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <FontIcon Glyph="" FontSize="16" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                                <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="Wrap" ToolTipService.ToolTip="{x:Bind Name}" Grid.Column="1"/>
                            </Grid>
                            <TextBlock Grid.Column="1" Text="{x:Bind DirectionDisplay}" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                            <TextBlock Grid.Column="2" Text="{x:Bind ProtocolDisplay}" VerticalAlignment="Center" HorizontalAlignment="Center" TextWrapping="Wrap"/>
                            <TextBlock Grid.Column="3" Text="{x:Bind PortDisplay}" VerticalAlignment="Center" HorizontalAlignment="Right" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
        <StackPanel x:Name="EmptyState" Grid.Row="3" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
            <FontIcon Glyph="" FontSize="36" Opacity="0.35"/>
            <TextBlock Text="{StaticResource Rules_Empty}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
        </StackPanel>
    </Grid>
</Page>
