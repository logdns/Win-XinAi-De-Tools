<?xml version='1.0' encoding='utf-8'?>
<Page xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="using:PortManager.Controls" x:Class="PortManager.Views.AddPortPage">
    <ScrollViewer Padding="32,28" VerticalScrollBarVisibility="Auto" HorizontalContentAlignment="Stretch">
        <StackPanel MaxWidth="760" HorizontalAlignment="Stretch" Spacing="24">
            <StackPanel>
                <TextBlock Text="{StaticResource Add_Title}" Style="{StaticResource PageTitle}" TextWrapping="Wrap"/>
                <TextBlock Text="{StaticResource Add_Subtitle}" Style="{StaticResource PageSubtitle}" TextWrapping="Wrap"/>
            </StackPanel>
            <InfoBar x:Name="ResultBar" IsOpen="False" IsClosable="True"/>
            <Border Style="{StaticResource CardPanel}">
                <Grid RowSpacing="18" ColumnSpacing="24" controls:AdaptiveLayout.CompactBelow="560">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <NumberBox x:Name="PortInput" Grid.Row="0" Grid.Column="0" Header="{StaticResource Add_Port}" PlaceholderText="1–65535" Minimum="1" Maximum="65535" SpinButtonPlacementMode="Compact" ValueChanged="Form_ValueChanged"/>
                    <ComboBox x:Name="ProtocolSelector" Grid.Row="0" Grid.Column="1" Header="{StaticResource Add_Protocol}" SelectedIndex="0" HorizontalAlignment="Stretch" SelectionChanged="Form_SelectionChanged">
                        <ComboBoxItem Content="TCP" Tag="TCP"/>
                        <ComboBoxItem Content="UDP" Tag="UDP"/>
                        <ComboBoxItem Content="ANY (TCP + UDP)" Tag="ANY"/>
                    </ComboBox>
                    <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Spacing="6">
                        <TextBlock Text="{StaticResource Add_Direction}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        <RadioButtons x:Name="DirectionSelector" SelectedIndex="0" SelectionChanged="Form_SelectionChanged">
                            <RadioButton Content="{StaticResource Add_Inbound}" Tag="in"/>
                            <RadioButton Content="{StaticResource Add_Outbound}" Tag="out"/>
                            <RadioButton Content="{StaticResource Add_Both}" Tag="Both"/>
                        </RadioButtons>
                    </StackPanel>
                    <TextBox x:Name="RuleNameInput" Grid.Row="2" Grid.ColumnSpan="2" Header="{StaticResource Add_RuleName}" PlaceholderText="{StaticResource Add_RuleNamePlaceholder}"/>
                </Grid>
            </Border>
            <Border Style="{StaticResource CardPanel}">
                <StackPanel Spacing="12">
                    <TextBlock Text="{StaticResource Add_Preview}" Style="{StaticResource SectionTitle}" TextWrapping="Wrap"/>
                    <Grid ColumnSpacing="20" RowSpacing="8" controls:AdaptiveLayout.CompactBelow="560">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="{StaticResource Add_Port}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                        <TextBlock x:Name="PreviewPort" Grid.Column="1" Text="--" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        <TextBlock Grid.Column="2" Text="{StaticResource Add_Protocol}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                        <TextBlock x:Name="PreviewProtocol" Grid.Column="3" Text="TCP" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        <TextBlock Grid.Row="1" Text="{StaticResource Add_Direction}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                        <TextBlock x:Name="PreviewDirection" Grid.Row="1" Grid.Column="1" Text="{StaticResource Add_Inbound}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        <TextBlock Grid.Row="1" Grid.Column="2" Text="{StaticResource Add_Action}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                        <TextBlock Grid.Row="1" Grid.Column="3" Text="{StaticResource Add_Allow}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    </Grid>
                </StackPanel>
            </Border>
            <controls:WrapPanel Spacing="10">
                <Button x:Name="AddButton" Style="{ThemeResource AccentButtonStyle}" Click="AddButton_Click">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="" Grid.Column="0"/>
                        <TextBlock x:Name="AddButtonText" Text="{StaticResource Add_Button}" Grid.Column="1" TextWrapping="Wrap"/>
                    </Grid>
                </Button>
                <Button Click="ResetButton_Click">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="" Grid.Column="0"/>
                        <TextBlock Text="{StaticResource Common_Reset}" Grid.Column="1" TextWrapping="Wrap"/>
                    </Grid>
                </Button>
            </controls:WrapPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
