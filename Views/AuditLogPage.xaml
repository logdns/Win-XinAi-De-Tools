<?xml version='1.0' encoding='utf-8'?>
<Page xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:models="using:PortManager.Models" xmlns:controls="using:PortManager.Controls" x:Class="PortManager.Views.AuditLogPage" Loaded="Page_Loaded">
    <Grid Padding="32,28" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="{StaticResource Audit_Title}" Style="{StaticResource PageTitle}" TextWrapping="Wrap"/>
            <TextBlock Text="{StaticResource Audit_Subtitle}" Style="{StaticResource PageSubtitle}" TextWrapping="Wrap"/>
        </StackPanel>
        <Grid Grid.Row="1" ColumnSpacing="10" controls:AdaptiveLayout.CompactBelow="560" RowSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Click="RefreshButton_Click">
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="" Grid.Column="0"/>
                    <TextBlock Text="{StaticResource Audit_Refresh}" Grid.Column="1" TextWrapping="Wrap"/>
                </Grid>
            </Button>
            <Button Grid.Column="1" Click="ClearButton_Click">
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="" Grid.Column="0"/>
                    <TextBlock Text="{StaticResource Audit_Clear}" Grid.Column="1" TextWrapping="Wrap"/>
                </Grid>
            </Button>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                <ProgressRing x:Name="LoadingRing" Width="20" Height="20" IsActive="False"/>
                <TextBlock x:Name="CountText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
            </StackPanel>
        </Grid>
        <Grid Grid.Row="2">
            <ListView x:Name="LogsList" SelectionMode="None">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="0,0,0,8"/>
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:AuditLogEntry">
                        <Border Style="{StaticResource CardPanel}" Padding="14,11">
                            <Grid ColumnSpacing="14" controls:AdaptiveLayout.CompactBelow="680" RowSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="170"/>
                                    <ColumnDefinition Width="130"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="80"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{x:Bind Timestamp}" TextWrapping="Wrap"/>
                                <TextBlock Grid.Column="1" Text="{x:Bind Action}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                <TextBlock Grid.Column="2" Text="{x:Bind Details}" TextWrapping="Wrap"/>
                                <TextBlock Grid.Column="3" Text="{x:Bind ResultDisplay}" HorizontalAlignment="Right" TextWrapping="Wrap"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <StackPanel x:Name="EmptyState" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
                <FontIcon Glyph="" FontSize="36" Opacity="0.35"/>
                <TextBlock Text="{StaticResource Audit_Empty}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
            </StackPanel>
            <InfoBar x:Name="ErrorBar" IsOpen="False" Severity="Error" VerticalAlignment="Top"/>
        </Grid>
    </Grid>
</Page>
