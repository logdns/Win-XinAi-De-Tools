<?xml version='1.0' encoding='utf-8'?>
<Page xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="using:PortManager.Controls" xmlns:toolkit="using:CommunityToolkit.WinUI.Controls" x:Class="PortManager.Views.DashboardPage" Loaded="Page_Loaded">
    <ScrollViewer Padding="32,28" VerticalScrollBarVisibility="Auto" HorizontalContentAlignment="Stretch">
        <StackPanel MaxWidth="960" HorizontalAlignment="Stretch" Spacing="24">
            <StackPanel>
                <TextBlock Text="{StaticResource Dashboard_Title}" Style="{StaticResource PageTitle}" TextWrapping="Wrap"/>
                <TextBlock Text="{StaticResource Dashboard_Subtitle}" Style="{StaticResource PageSubtitle}" TextWrapping="Wrap"/>
            </StackPanel>
            <InfoBar x:Name="ErrorBar" IsOpen="False" Severity="Error" Title="{StaticResource Common_FirewallError}" Message="{StaticResource Common_FirewallErrorDetail}">
                <InfoBar.ActionButton>
                    <Button Content="{StaticResource Common_Retry}" Click="RetryButton_Click"/>
                </InfoBar.ActionButton>
            </InfoBar>
            <Border Style="{StaticResource CardPanel}" Background="{ThemeResource HeroBackgroundBrush}" BorderBrush="{ThemeResource HeroBorderBrush}">
                <Grid ColumnSpacing="24" RowSpacing="16" controls:AdaptiveLayout.CompactBelow="520">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="200"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="10" VerticalAlignment="Center">
                        <TextBlock Text="{StaticResource Dashboard_RuleCount}" Style="{StaticResource SectionTitle}"/>
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <TextBlock x:Name="RuleCount" Text="--" FontSize="44" FontWeight="SemiBold"/>
                            <ProgressRing x:Name="LoadingRing" Width="22" Height="22" IsActive="True"/>
                        </StackPanel>
                        <TextBlock x:Name="FirewallStatusText" Text="{StaticResource Dashboard_Loading}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <TextBlock Text="{StaticResource Dashboard_Distribution}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        <TextBlock x:Name="DistributionSummary" Text="{StaticResource Dashboard_Loading}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
                        <Button Content="{StaticResource Common_Refresh}" Click="RetryButton_Click" HorizontalAlignment="Left"/>
                    </StackPanel>
                    <controls:RuleDistributionChart x:Name="DistributionChart" Grid.Column="1" Height="180" HorizontalAlignment="Stretch" AutomationProperties.AccessibilityView="Raw"/>
                </Grid>
            </Border>
            <StackPanel Spacing="12">
                <TextBlock Text="{StaticResource Dashboard_QuickActions}" Style="{StaticResource SectionTitle}" TextWrapping="Wrap"/>
                <Grid ColumnSpacing="12" controls:AdaptiveLayout.CompactBelow="560" RowSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="16,12" Click="AddPort_Click">
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="" Grid.Column="0"/>
                            <TextBlock Text="{StaticResource Dashboard_Add}" Grid.Column="1" TextWrapping="Wrap"/>
                        </Grid>
                    </Button>
                    <Button Grid.Column="1" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="16,12" Click="ListRules_Click">
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="" Grid.Column="0"/>
                            <TextBlock Text="{StaticResource Dashboard_View}" Grid.Column="1" TextWrapping="Wrap"/>
                        </Grid>
                    </Button>
                    <Button Grid.Column="2" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="16,12" Click="PortStatus_Click">
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="" Grid.Column="0"/>
                            <TextBlock Text="{StaticResource Dashboard_Query}" Grid.Column="1" TextWrapping="Wrap"/>
                        </Grid>
                    </Button>
                </Grid>
            </StackPanel>
            <StackPanel Spacing="12">
                <TextBlock Text="{StaticResource Dashboard_Extensions}" Style="{StaticResource SectionTitle}" TextWrapping="Wrap"/>
                <toolkit:SettingsCard Header="{StaticResource Nav_More}" Description="{StaticResource Dashboard_ExtensionsDescription}" IsClickEnabled="True" Click="MoreFeatures_Click">
                    <toolkit:SettingsCard.HeaderIcon>
                        <FontIcon Glyph=""/>
                    </toolkit:SettingsCard.HeaderIcon>
                </toolkit:SettingsCard>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
