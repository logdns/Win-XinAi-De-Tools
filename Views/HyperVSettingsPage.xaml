<?xml version="1.0" encoding="utf-8"?>
<Page xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="using:PortManager.Controls" x:Class="PortManager.Views.HyperVSettingsPage" Loaded="Page_Loaded">
    <ScrollViewer Padding="32,28" VerticalScrollBarVisibility="Auto" HorizontalContentAlignment="Stretch">
        <StackPanel MaxWidth="900" HorizontalAlignment="Stretch" Spacing="18">
            <TextBlock Text="{StaticResource HyperV_Title}" Style="{StaticResource PageTitle}" TextWrapping="Wrap"/>
            <InfoBar IsOpen="True" IsClosable="False" Severity="Warning" Title="{StaticResource HyperV_RiskTitle}" Message="{StaticResource HyperV_Risk}"/>
            <controls:WrapPanel Spacing="10">
                <Button x:Name="RefreshButton" Content="{StaticResource Network_Refresh}" Click="RefreshButton_Click"/>
                <ProgressRing x:Name="LoadingRing" Width="20" Height="20" IsActive="False"/>
            </controls:WrapPanel>
            <InfoBar x:Name="ResultBar" IsOpen="False" IsClosable="True"/>
            <Border Style="{StaticResource CardPanel}">
                <StackPanel Spacing="12">
                    <TextBlock Text="{StaticResource HyperV_Features}" Style="{StaticResource SectionTitle}" TextWrapping="Wrap"/>
                    <TextBlock x:Name="StatusText" TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
                    <TextBlock Text="{StaticResource HyperV_FeatureHelp}" TextWrapping="Wrap"/>
                    <controls:WrapPanel x:Name="FeatureActions" Spacing="10">
                        <Button x:Name="EnableFeatureButton" Content="{StaticResource HyperV_Enable}" Click="EnableFeatureButton_Click"/>
                        <Button x:Name="DisableFeatureButton" Content="{StaticResource HyperV_DisableFeature}" Click="DisableFeatureButton_Click"/>
                        <Button x:Name="CompleteDisableButton" Content="{StaticResource HyperV_CompleteDisable}" Click="CompleteDisableButton_Click"/>
                    </controls:WrapPanel>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardPanel}">
                <StackPanel Spacing="12">
                    <TextBlock Text="{StaticResource HyperV_Network}" Style="{StaticResource SectionTitle}" TextWrapping="Wrap"/>
                    <TextBlock Text="{StaticResource HyperV_NetworkHelp}" TextWrapping="Wrap"/>
                    <ComboBox x:Name="VirtualAdapterSelector" DisplayMemberPath="DisplayName" HorizontalAlignment="Stretch" Header="{StaticResource HyperV_Adapter}" SelectionChanged="Selector_SelectionChanged"/>
                    <controls:WrapPanel x:Name="NetworkActions" Spacing="10">
                        <Button x:Name="EnableAdapterButton" Content="{StaticResource HyperV_EnableAdapter}" Click="EnableAdapterButton_Click"/>
                        <Button x:Name="DisableAdapterButton" Content="{StaticResource HyperV_DisableAdapter}" Click="DisableAdapterButton_Click"/>
                        <Button x:Name="EnableAllButton" Content="{StaticResource HyperV_EnableAll}" Click="EnableAllButton_Click"/>
                        <Button x:Name="DisableAllButton" Content="{StaticResource HyperV_DisableAll}" Click="DisableAllButton_Click"/>
                        <Button x:Name="IpSettingsButton" Content="{StaticResource HyperV_IpSettings}" Click="IpSettingsButton_Click"/>
                    </controls:WrapPanel>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardPanel}">
                <StackPanel Spacing="12">
                    <TextBlock Text="{StaticResource HyperV_Switches}" Style="{StaticResource SectionTitle}" TextWrapping="Wrap"/>
                    <TextBlock Text="{StaticResource HyperV_SwitchHelp}" TextWrapping="Wrap"/>
                    <ComboBox x:Name="SwitchSelector" DisplayMemberPath="DisplayName" Header="{StaticResource HyperV_Switch}" HorizontalAlignment="Stretch" SelectionChanged="Selector_SelectionChanged"/>
                    <Button x:Name="RemoveSwitchButton" Content="{StaticResource HyperV_RemoveSwitch}" Click="RemoveSwitchButton_Click"/>
                    <Grid x:Name="SwitchForm" ColumnSpacing="16" RowSpacing="12" controls:AdaptiveLayout.CompactBelow="560">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <TextBox x:Name="SwitchNameBox" Header="{StaticResource HyperV_SwitchName}" MaxLength="64"/>
                        <ComboBox x:Name="SwitchTypeSelector" Grid.Column="1" Header="{StaticResource HyperV_SwitchType}" HorizontalAlignment="Stretch" SelectedIndex="0" SelectionChanged="Selector_SelectionChanged">
                            <ComboBoxItem Content="{StaticResource HyperV_Internal}"/>
                            <ComboBoxItem Content="{StaticResource HyperV_Private}"/>
                            <ComboBoxItem Content="{StaticResource HyperV_External}"/>
                        </ComboBox>
                        <ComboBox x:Name="PhysicalAdapterSelector" Grid.Row="1" DisplayMemberPath="DisplayName" Header="{StaticResource HyperV_PhysicalAdapter}" HorizontalAlignment="Stretch"/>
                        <CheckBox x:Name="AllowHostCheck" Grid.Row="1" Grid.Column="1" IsChecked="True">
                            <TextBlock Text="{StaticResource HyperV_AllowHost}" TextWrapping="Wrap"/>
                        </CheckBox>
                    </Grid>
                    <Button x:Name="CreateSwitchButton" Content="{StaticResource HyperV_CreateSwitch}" Click="CreateSwitchButton_Click"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
